# Gemini API key (server only — never in extension)
GEMINI_API_KEY=AIza...

# GitHub Personal Access Token (for creating PRs)
GITHUB_TOKEN=ghp_...
# Local API port (extension options default to this port on 127.0.0.1)
PORT=3847

# CSPRNG secret, 32+ bytes — extension sends as X-Resume-Agent-Token
BACKEND_SHARED_SECRET=

# Default resume GitHub repo for runs (https://github.com/you/resume)
RESUME_REPO_URL=https://github.com/you/your-resume-repo

# Chrome extension origin for CORS (from chrome://extensions)
DEV_EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# Agent runtime: cloud (GitHub + Cursor integration) | local (cloned repo on disk)
AGENT_RUNTIME=cloud

# Required when AGENT_RUNTIME=local — path to git clone of resume repo
# LOCAL_RESUME_REPO_PATH=/absolute/path/to/your-resume-repo

# Cloud only — branch Cursor verifies on GitHub (default main)
# CLOUD_STARTING_REF=main

# Optional: replay fixture path for demo mode (no SDK call)
# DEMO_RUN_FIXTURE_PATH=./fixtures/demo-run.json
