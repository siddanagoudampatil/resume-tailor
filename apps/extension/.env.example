# Local dev defaults baked into the extension at build time by Vite.
# Copy this file to apps/extension/.env.local (gitignored) and fill in values.
# Keep these in sync with apps/api/.env.

# API port (same as PORT in apps/api/.env)
VITE_RESUME_AGENT_PORT=3847

# Shared token (same value as BACKEND_SHARED_SECRET in apps/api/.env)
VITE_RESUME_AGENT_TOKEN=

# Default resume repo URL shown in the extension
VITE_RESUME_AGENT_REPO_URL=https://github.com/you/your-resume-repo
